# Valores exclusivos para desenvolvimento local. Copie para .env e substitua-os.
POSTGRES_PASSWORD=change-this-local-password
JWT_SIGNING_KEY=change-this-with-at-least-32-random-bytes
# Opcionais no primeiro start; remova depois que o administrador for criado.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password1!
